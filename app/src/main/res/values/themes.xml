<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SegundoAire" parent="Theme.AppCompat.Light.NoActionBar" />

    <!--
        Tema de arranque: solo el fondo, sin ícono ni texto. Sigue al tema del
        sistema (colores en values-night). La animación El Respiro la dibuja
        Compose encima de la app (presentation/splash). MainActivity cambia este
        tema por Theme.SegundoAire al llamar a installSplashScreen().
    -->
    <style name="Theme.SegundoAire.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.SegundoAire</item>
    </style>
</resources>
